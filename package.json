<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>3D Mold Maker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #fbf6ee;
        --bg-2: #f3ece0;
        --line: #e6dfd1;
        --line-strong: #d6cdba;
        --text: #181818;
        --muted: #6b6356;
        --accent: #ee5a2c;
        --accent-hover: #d44d22;
        --accent-tint: #fde8df;
        --canvas: #f3ece0;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        height: 100%;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        font-size: 13px;
        color: var(--text);
        background: var(--canvas);
      }
      body { display: flex; flex-direction: row; }

      aside#panel {
        width: 320px;
        flex: 0 0 320px;
        background: var(--bg);
        border-right: 1px solid var(--line);
        overflow-y: auto;
        padding: 18px 18px 14px;
        display: flex;
        flex-direction: column;
      }
      .eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
      }
      .eyebrow::before {
        content: "";
        width: 22px;
        height: 2px;
        background: var(--accent);
        border-radius: 1px;
      }
      .brand { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
      .brand-logo {
        width: 32px; height: 32px;
        border-radius: 8px;
        background: var(--accent);
        display: grid; place-items: center;
        color: #fff;
      }
      .brand-name {
        font-family: 'Anton', 'Inter', system-ui, sans-serif;
        font-weight: 400;
        font-size: 26px;
        letter-spacing: 0.01em;
        line-height: 1;
        text-transform: uppercase;
        color: var(--text);
      }
      .brand-tag {
        margin-top: 10px;
        font-size: 12px;
        color: var(--muted);
        line-height: 1.5;
      }

      .panel-section { margin-top: 16px; }
      .panel-section + .panel-section { margin-top: 14px; }
      .section-head {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 8px;
      }

      .drop {
        display: block;
        border: 1.5px dashed var(--line-strong);
        background: #fff;
        border-radius: 12px;
        padding: 18px 14px;
        text-align: center;
        cursor: pointer;
        transition: background 0.12s, border-color 0.12s;
        font-size: 12px;
        color: var(--muted);
      }
      .drop:hover, .drop.hover {
        background: var(--accent-tint);
        border-color: var(--accent);
        color: var(--text);
      }
      .drop.loaded { color: var(--text); }
      .drop strong { color: var(--text); }
      .drop input[type="file"] {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
      }

      .row { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
      .row .label {
        font-size: 12px;
        color: var(--text);
        flex: 0 0 auto;
        min-width: 14px;
      }
      .row input[type="range"] {
        flex: 1;
        accent-color: var(--accent);
      }
      .row .value {
        font-size: 11px;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
        min-width: 32px;
        text-align: right;
      }

      .segmented {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 1fr;
        gap: 4px;
        background: #fff;
        padding: 3px;
        border-radius: 999px;
        border: 1px solid var(--line);
      }
      .seg {
        background: transparent;
        border: 0;
        color: var(--text);
        font: inherit;
        font-size: 12px;
        font-weight: 500;
        padding: 7px 8px;
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.12s, color 0.12s;
      }
      .seg:hover:not(.active) { background: rgba(0, 0, 0, 0.04); }
      .seg.active {
        background: var(--accent);
        color: #fff;
      }

      .check {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        cursor: pointer;
        user-select: none;
        margin-top: 4px;
      }
      .check input { accent-color: var(--accent); }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        padding: 12px 14px;
        background: var(--accent);
        color: #fff;
        border: 0;
        border-radius: 999px;
        font: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.12s, transform 0.12s, opacity 0.12s;
      }
      .btn:hover:not(:disabled) { background: var(--accent-hover); }
      .btn:active { transform: translateY(1px); }
      .btn:disabled { opacity: 0.45; cursor: not-allowed; }
      .btn.btn-secondary {
        background: #fff;
        color: var(--text);
        border: 1px solid var(--line-strong);
      }
      .btn.btn-secondary:hover:not(:disabled) {
        background: var(--accent-tint);
        border-color: var(--accent);
        color: var(--accent);
      }
      .btn + .btn { margin-top: 6px; }

      .footer {
        margin-top: auto;
        padding-top: 14px;
        font-size: 10px;
        color: var(--muted);
        opacity: 0.7;
      }
      .footer a { color: inherit; text-decoration: none; }
      .footer a:hover { text-decoration: underline; }

      main#canvas-wrap {
        flex: 1;
        position: relative;
        background: #1f1d1a;
        min-width: 0;
      }
      main#canvas-wrap canvas { display: block; }

      .status-toast {
        position: absolute;
        left: 50%;
        bottom: 18px;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.72);
        color: #fff;
        padding: 8px 14px;
        border-radius: 6px;
        font-size: 12px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s;
      }
      .status-toast.show { opacity: 1; }

      .spinner {
        display: inline-block;
        width: 12px; height: 12px;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.25);
        border-top-color: #fff;
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }

      .disabled-when-auto { opacity: 0.45; }

      @media (max-width: 720px) {
        body { flex-direction: column; }
        aside#panel { width: 100%; flex: 0 0 auto; max-height: 50vh; border-right: 0; border-bottom: 1px solid var(--line); }
      }
    </style>
  </head>
  <body>
    <aside id="panel">
      <div class="eyebrow">3D PRINT YOUR OWN MOLDS</div>
      <div class="brand">
        <div class="brand-logo" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7l9-4 9 4M3 7v10l9 4 9-4V7M3 7l9 4 9-4M12 11v10"/>
          </svg>
        </div>
        <div class="brand-name">Mold Maker</div>
      </div>
      <div class="brand-tag">Drop an STL → generate a printable mold shell → split &amp; export the halves.</div>

      <div class="panel-section">
        <label class="drop" id="drop">
          <input type="file" id="file-input" accept=".stl,model/stl" />
          <div id="drop-text">Drop or click to upload STL</div>
        </label>
      </div>

      <div class="panel-section">
        <div class="section-head">Position</div>
        <div class="row">
          <span class="label">X</span>
          <input id="posX" type="range" min="-50" max="50" step="0.5" value="0" />
          <span class="value" id="posXVal">0</span>
        </div>
        <div class="row">
          <span class="label">Y</span>
          <input id="posY" type="range" min="-50" max="50" step="0.5" value="0" />
          <span class="value" id="posYVal">0</span>
        </div>
      </div>

      <div class="panel-section">
        <div class="section-head">Resolution</div>
        <div class="segmented" id="res-seg" role="group" aria-label="Voxel resolution">
          <button class="seg" data-res="32" type="button">32</button>
          <button class="seg active" data-res="64" type="button">64</button>
          <button class="seg" data-res="128" type="button">128</button>
        </div>
      </div>

      <div class="panel-section">
        <div class="section-head">Smoothing</div>
        <div class="row">
          <span class="label" style="min-width:0;"></span>
          <input id="smoothing" type="range" min="0" max="10" step="1" value="3" />
          <span class="value" id="smoothingVal">3</span>
        </div>
      </div>

      <div class="panel-section">
        <label class="check">
          <input id="autoOpt" type="checkbox" checked />
          <span>Auto-optimize</span>
        </label>
        <div class="row" id="biasRow">
          <span class="label">Bias</span>
          <input id="bias" type="range" min="0" max="100" step="1" value="50" />
          <span class="value" id="biasVal">50</span>
        </div>
      </div>

      <div class="panel-section">
        <button id="generateBtn" class="btn" disabled>
          <span id="generateLabel">Contour Split</span>
        </button>
      </div>

      <div class="panel-section">
        <div class="section-head">Preview half</div>
        <div class="segmented" id="half-seg" role="group" aria-label="Preview half">
          <button class="seg active" data-half="front" type="button">Front</button>
          <button class="seg" data-half="back" type="button">Back</button>
        </div>
      </div>

      <div class="panel-section">
        <button id="dlFront" class="btn btn-secondary" disabled>Download Front Half (.stl)</button>
        <button id="dlBack" class="btn btn-secondary" disabled>Download Back Half (.stl)</button>
      </div>

      <div class="panel-section">
        <div class="section-head">View</div>
        <div class="segmented" id="view-seg" role="group" aria-label="View">
          <button class="seg active" data-view="original" type="button">Original</button>
          <button class="seg" data-view="mold" type="button">Mold</button>
          <button class="seg" data-view="front" type="button">Front</button>
          <button class="seg" data-view="back" type="button">Back</button>
        </div>
      </div>

      <div class="panel-section">
        <label class="check">
          <input id="wireframe" type="checkbox" />
          <span>Wireframe <span style="color:var(--muted);">(W)</span></span>
        </label>
        <button id="resetView" class="btn btn-secondary" style="margin-top:6px;">Reset View</button>
      </div>

      <div class="footer">
        <a href="#" id="questionsLink">Questions?</a> · <a href="#" id="privacyLink">Privacy</a> · <a href="#" id="termsLink">Terms</a>
      </div>
    </aside>

    <main id="canvas-wrap">
      <div class="status-toast" id="toast"></div>
    </main>

    <script type="module" src="/src/main.ts"></script>
  </body>
</html>
